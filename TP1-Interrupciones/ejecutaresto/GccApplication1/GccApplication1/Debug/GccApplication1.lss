  ac:	84 bd       	out	0x24, r24	; 36

    // Prescaler 64: CS01 = 1, CS00 = 1 (TCCR0B)
    // Frecuencia del timer: 16 MHz / 64 = 250 kHz -> 1 tick = 4 us
    TCCR0B = (1 << CS01) | (1 << CS00);
