; ============================================================================
; reglas_energia.nls
; Modulo reutilizable para modelar:
;   Temperatura -> Aires Acondicionados -> Consumo Electrico -> Cortes y Reposicion
;
; Disenado para importarse con:
;   __includes [ "reglas_energia.nls" ]
; desde el modelo principal de NetLogo (requiere la extension [csv] ya cargada).
;
; Arquitectura agnostica de escala:
;   Todos los calculos se formulan por cliente y por capacidad instalada (kVA).
;   Por lo tanto, el mismo modulo aplica hoy a las 6 subestaciones AT/MT (mt-subs)
;   y en futuras iteraciones a transformadores barriales MT/BT sin reescribir reglas.
;
; REQUISITO EN EL MODELO PRINCIPAL:
;   Todo breed que actue como "nodo de carga" (ej. mt-subs hoy, o trafos-bt manana)
;   debe declarar en su `*-own` ademas de `clientes` y `pot-instalada` (en kVA):
;
;     estado                 ; "operativo" | "sobrecargado" | "cortado"
;     demanda-base-mw        ; MW base sin refrigeracion
;     demanda-aa-mw          ; MW aportados por aires acondicionados
;     carga-actual-mw        ; MW totales demandados (0 cuando esta cortado)
;     aa-encendidos          ; cantidad estimada de equipos AA activos
;     factor-carga           ; carga-actual-mw / capacidad-efectiva-mw
;     estres-termico         ; acumulador termico >= 0 (dispara al superar limite)
;     timer-reposicion       ; ticks restantes para restablecer suministro
;     ticks-post-reconexion  ; ticks restantes con pico transitorio de reconexion
;     cant-cortes            ; cantidad acumulada de cortes en el nodo
;
; Documentacion completa y justificacion de parametros:
;   TrabajoFinal/analisis/modelo_aa_y_cortes.md
; ============================================================================

globals [
  ; --- Datos cargados desde el analisis de demanda ---
  perfil-base-habil         ; lista de 24 valores (MW totales region EDELAP, dia habil)
  perfil-base-finde         ; lista de 24 valores (MW totales region EDELAP, fin de semana)
  clientes-totales-red      ; suma dinamica de clientes de los nodos de carga

  ; --- Parametros del modelo de demanda y aires acondicionados ---
  ; (Si se exponen como sliders en la interfaz del .nlogox, comentar aqui la
  ;  variable correspondiente o sincronizarla antes de llamar a step-*)
  cfg-escala-red            ; fraccion de la demanda CAMMESA cubierta por la red modelada (def: 0.55)
  cfg-eq-aa-por-cliente     ; equipos de AA instalados por cliente en el escenario (def: 0.90)
  cfg-pot-unit-aa-kw        ; potencia electrica efectiva por AA encendido en kW (def: 1.15)
  cfg-eq-aa-ref             ; valor de calibracion de referencia (def: 0.90)
  cfg-pot-unit-aa-ref-kw    ; potencia de calibracion de referencia en kW (def: 1.15)
  cfg-f-sim-max             ; tope fisico de simultaneidad de AA encendidos (def: 0.85)
  cfg-cos-phi               ; factor de potencia kVA -> MW de transformadores (def: 0.95)

  ; --- Parametros de sobrecarga, corte y restablecimiento ---
  cfg-minutos-por-tick      ; resolucion temporal del simulador en minutos (def: 5)
  cfg-umbral-alerta         ; factor de carga para alerta temprana / fail-soft (def: 0.85)
  cfg-umbral-sobrecarga     ; factor de carga a partir del cual acumula estres termico (def: 1.00)
  cfg-umbral-corte-inmediato ; factor de carga de disparo instantaneo (def: 1.25)
  cfg-limite-estres-termico ; estres acumulado necesario para disparar proteccion (def: 0.60)
  cfg-tasa-enfriamiento-op  ; enfriamiento por paso de 5 min en estado operativo (def: 0.05)
  cfg-tasa-enfriamiento-al  ; enfriamiento por paso de 5 min en alerta <= 100% (def: 0.02)
  cfg-tasa-enfriamiento-off ; enfriamiento por paso de 5 min mientras esta cortado (def: 0.08)
  cfg-reposicion-min-min    ; tiempo minimo de reposicion tras un corte en minutos (def: 60)
  cfg-reposicion-max-min    ; tiempo maximo de reposicion tras un corte en minutos (def: 180)
  cfg-factor-rebote         ; multiplicador transitorio de reconexion / cold load pickup (def: 1.20)
  cfg-duracion-rebote-min   ; duracion del pico de reconexion en minutos (def: 15)
]


; ============================================================================
; 1. INICIALIZACION Y CARGA DE PERFILES
; ============================================================================

; Inicializa los parametros por defecto, carga el perfil base horario
; y registra la cantidad total de clientes del conjunto de nodos de carga.
; Ejemplo de uso en setup:
;   init-reglas-energia "../analisis/data/perfil_base_horario.csv" mt-subs
to init-reglas-energia [ ruta-perfil-csv nodos-carga ]
  ; Parametros de demanda y AA
  set cfg-escala-red 0.55
  set cfg-eq-aa-ref 0.90
  set cfg-pot-unit-aa-ref-kw 1.15
  set cfg-eq-aa-por-cliente cfg-eq-aa-ref
  set cfg-pot-unit-aa-kw cfg-pot-unit-aa-ref-kw
  set cfg-f-sim-max 0.85
  set cfg-cos-phi 0.95

  ; Parametros de proteccion termica y reposicion
  set cfg-minutos-por-tick 5
  set cfg-umbral-alerta 0.85
  set cfg-umbral-sobrecarga 1.00
  set cfg-umbral-corte-inmediato 1.25
  set cfg-limite-estres-termico 0.60
  set cfg-tasa-enfriamiento-op 0.05
  set cfg-tasa-enfriamiento-al 0.02
  set cfg-tasa-enfriamiento-off 0.08
  set cfg-reposicion-min-min 60
  set cfg-reposicion-max-min 180
  set cfg-factor-rebote 1.20
  set cfg-duracion-rebote-min 15

  cargar-perfil-base ruta-perfil-csv

  set clientes-totales-red sum [ clientes ] of nodos-carga
  if clientes-totales-red <= 0 [
    set clientes-totales-red 196972
  ]

  ask nodos-carga [ iniciar-nodo-carga ]
end

; Carga perfil_base_horario.csv (columnas: hora, habil, finde).
; Si no encuentra el archivo en la ruta dada, usa el perfil respaldado del analisis.
to cargar-perfil-base [ ruta-csv ]
  ifelse file-exists? ruta-csv [
    let filas but-first csv:from-file ruta-csv
    set perfil-base-habil map [ f -> item 1 f ] filas
    set perfil-base-finde map [ f -> item 2 f ] filas
  ] [
    print (word "[reglas_energia] Aviso: no se encontro " ruta-csv "; se usa perfil base embebido.")
    set perfil-base-habil [ 343 317 299 291 287 289 303 310 327 345 354 366 373 374 367 364 363 367 377 407 434 431 405 376 ]
    set perfil-base-finde [ 326 305 287 279 272 269 266 258 271 291 301 314 324 327 322 318 320 328 339 371 394 389 368 346 ]
  ]
end

; Inicializa variables de estado de un nodo de carga (contexto: agente de carga).
to iniciar-nodo-carga
  set estado "operativo"
  set demanda-base-mw 0
  set demanda-aa-mw 0
  set carga-actual-mw 0
  set aa-encendidos 0
  set factor-carga 0
  set estres-termico 0
  set timer-reposicion 0
  set ticks-post-reconexion 0
  set cant-cortes 0
end


; ============================================================================
; 2. MODELO DE TEMPERATURA, AIRES ACONDICIONADOS Y DEMANDA ELECTRICA
; ============================================================================

; Regla empirica obtenida del analisis CAMMESA (dos quiebres por BIC: 22 C y 30.5 C).
; - T <= 22 C      : k = 1.0 (sin demanda adicional por refrigeracion)
; - 22 < T <= 30.5 : +1.14 %/C
; - T > 30.5       : +4.43 %/C
to-report multiplicador-temp [ T ]
  let c1 max (list 0 (min (list (T - 22) 8.5)))
  let c2 max (list 0 (T - 30.5))
  report exp (0.01132 * c1 + 0.04338 * c2)
end

; Demanda base total de la region EDELAP (MW) para la hora [0..23] y tipo de dia.
to-report base-horaria-mw [ hora finde? ]
  let h ((floor hora) mod 24)
  if h < 0 [ set h h + 24 ]
  ifelse finde?
    [ report item h perfil-base-finde ]
    [ report item h perfil-base-habil ]
end

; Demanda base unitaria por cliente (kW/cliente) en la red modelada.
to-report base-por-cliente-kw [ hora finde? ]
  report ((base-horaria-mw hora finde?) * cfg-escala-red * 1000) / clientes-totales-red
end

; Fraccion f_on(h, d, T) de equipos de AA encendidos simultaneamente [0, cfg-f-sim-max].
; Calibrada contra k(T) usando el parque de referencia (cfg-eq-aa-ref, cfg-pot-unit-aa-ref-kw).
; Con parametros por defecto reproduce exactamente la curva CAMMESA hasta el tope fisico.
to-report fraccion-aa-encendidos [ hora finde? T ]
  let k multiplicador-temp T
  if k <= 1 [ report 0 ]
  let p-base-cli base-por-cliente-kw hora finde?
  let delta-calor-cli p-base-cli * (k - 1)
  let pot-aa-inst-ref-cli (cfg-eq-aa-ref * cfg-pot-unit-aa-ref-kw)
  if pot-aa-inst-ref-cli <= 0 [ report 0 ]
  let f-raw delta-calor-cli / pot-aa-inst-ref-cli
  report min (list cfg-f-sim-max (max (list 0 f-raw)))
end

; Capacidad activa maxima del nodo de carga en MW (contexto: agente de carga).
to-report capacidad-efectiva-mw
  report (pot-instalada / 1000) * cfg-cos-phi
end

; Calcula la demanda base, los AA encendidos y la carga total de un nodo de carga
; (contexto: agente de carga con `clientes` y `pot-instalada`).
to actualizar-demanda-nodo [ hora finde? T ]
  ifelse estado = "cortado" [
    set demanda-base-mw 0
    set demanda-aa-mw 0
    set aa-encendidos 0
    set carga-actual-mw 0
    set factor-carga 0
  ] [
    let p-base-cli base-por-cliente-kw hora finde?
    let f-on fraccion-aa-encendidos hora finde? T

    set demanda-base-mw (clientes * p-base-cli) / 1000
    set aa-encendidos round (clientes * cfg-eq-aa-por-cliente * f-on)
    set demanda-aa-mw (aa-encendidos * cfg-pot-unit-aa-kw) / 1000

    let carga-bruta demanda-base-mw + demanda-aa-mw

    ; Pico transitorio de reconexion (cold load pickup) tras volver de un corte
    if ticks-post-reconexion > 0 [
      set carga-bruta carga-bruta * cfg-factor-rebote
      set ticks-post-reconexion ticks-post-reconexion - 1
    ]

    set carga-actual-mw carga-bruta
    let cap capacidad-efectiva-mw
    ifelse cap > 0
      [ set factor-carga carga-actual-mw / cap ]
      [ set factor-carga 0 ]
  ]
end


; ============================================================================
; 3. MAQUINA DE ESTADOS: SOBRECARGA TERMICA, CORTE Y RESTABLECIMIENTO
; ============================================================================

; Evalua la transicion de estado del nodo de carga en el tick actual
; (contexto: agente de carga).
to actualizar-estado-nodo
  let paso-rel cfg-minutos-por-tick / 5

  ifelse estado = "cortado" [
    ; El equipo se enfria mientras esta desenergizado y avanza el timer de reposicion
    set estres-termico max (list 0 (estres-termico - (cfg-tasa-enfriamiento-off * paso-rel)))
    set timer-reposicion timer-reposicion - 1
    if timer-reposicion <= 0 [
      set estado "operativo"
      set estres-termico 0
      set ticks-post-reconexion max (list 1 (round (cfg-duracion-rebote-min / cfg-minutos-por-tick)))
    ]
  ] [
    ; Nodo energizado: verificar disparo inmediato o acumulacion termica
    (ifelse
      factor-carga >= cfg-umbral-corte-inmediato [
        disparar-corte-nodo
      ]
      factor-carga > cfg-umbral-sobrecarga [
        set estado "sobrecargado"
        let exceso (factor-carga - cfg-umbral-sobrecarga)
        set estres-termico estres-termico + (exceso * paso-rel)
        if estres-termico >= cfg-limite-estres-termico [
          disparar-corte-nodo
        ]
      ]
      factor-carga >= cfg-umbral-alerta [
        set estado "sobrecargado"
        set estres-termico max (list 0 (estres-termico - (cfg-tasa-enfriamiento-al * paso-rel)))
      ]
      [
        set estado "operativo"
        set estres-termico max (list 0 (estres-termico - (cfg-tasa-enfriamiento-op * paso-rel)))
      ])
  ]
end

; Fuerza el paso a estado "cortado" y sortea el tiempo de reposicion
; (contexto: agente de carga).
to disparar-corte-nodo
  if estado != "cortado" [
    set cant-cortes cant-cortes + 1
  ]
  set estado "cortado"
  set demanda-base-mw 0
  set demanda-aa-mw 0
  set aa-encendidos 0
  set carga-actual-mw 0
  set factor-carga 0
  set ticks-post-reconexion 0
  let dur-min cfg-reposicion-min-min + random-float (max (list 0 (cfg-reposicion-max-min - cfg-reposicion-min-min)))
  set timer-reposicion max (list 1 (round (dur-min / cfg-minutos-por-tick)))
end

; Representacion visual estandar del estado del nodo (contexto: agente de carga).
to colorear-nodo-carga
  (ifelse
    estado = "cortado"      [ set color red ]
    estado = "sobrecargado" [ set color orange ]
    [ set color green ])
end


; ============================================================================
; 4. EJECUCION POR TICK (RED PLANA Y RED JERARQUICA CON TRAFOS MT/BT)
; ============================================================================

; Paso completo para el modelo actual (nodos de carga en un solo nivel, ej. mt-subs).
to step-red-simple [ nodos-carga hora finde? T ]
  ask nodos-carga [
    actualizar-demanda-nodo hora finde? T
    actualizar-estado-nodo
    colorear-nodo-carga
  ]
end

; Actualiza una subestacion padre (AT/MT) agregando la carga real de sus
; transformadores hijos (MT/BT) operativos. Si la subestacion dispara, corta
; en cascada a todos sus hijos (contexto: subestacion padre).
to actualizar-subestacion-agregada [ hijos ]
  ifelse estado = "cortado" [
    set demanda-base-mw 0
    set demanda-aa-mw 0
    set aa-encendidos 0
    set carga-actual-mw 0
    set factor-carga 0
    actualizar-estado-nodo
    ; Mientras la subestacion siga cortada, sus hijos permanecen sin tension
    if estado = "cortado" [
      ask hijos [
        set estado "cortado"
        set demanda-base-mw 0
        set demanda-aa-mw 0
        set aa-encendidos 0
        set carga-actual-mw 0
        set factor-carga 0
        set timer-reposicion max (list timer-reposicion 1)
        colorear-nodo-carga
      ]
    ]
  ] [
    set demanda-base-mw sum [ demanda-base-mw ] of hijos
    set demanda-aa-mw sum [ demanda-aa-mw ] of hijos
    set aa-encendidos sum [ aa-encendidos ] of hijos
    set carga-actual-mw sum [ carga-actual-mw ] of hijos
    let cap capacidad-efectiva-mw
    ifelse cap > 0
      [ set factor-carga carga-actual-mw / cap ]
      [ set factor-carga 0 ]
    actualizar-estado-nodo
    if estado = "cortado" [
      let t-rep timer-reposicion
      ask hijos [
        disparar-corte-nodo
        set timer-reposicion max (list timer-reposicion t-rep)
        colorear-nodo-carga
      ]
    ]
  ]
  colorear-nodo-carga
end


; ============================================================================
; 5. UTILIDADES DE ESCENARIO DE TEMPERATURA Y METRICAS GLOBALES
; ============================================================================

; Genera un perfil termico diario suave (minimo a las 03:00, maximo a las 15:00).
; Nota: en NetLogo `cos` recibe grados.
to-report temperatura-diaria-sintetica [ hora t-min t-max ]
  let t-media (t-min + t-max) / 2
  let amplitud (t-max - t-min) / 2
  report t-media + amplitud * cos (15 * (hora - 15))
end

; Carga la serie de temperaturas (cada 5 min) de una fecha puntual (ej. "2026-02-03")
; desde demanda_la_plata_2026_con_temperatura.csv.
; Devuelve una lista de temperaturas (hasta 288 valores para 24 h).
to-report cargar-temperaturas-dia [ ruta-csv fecha-prefijo ]
  let serie []
  if not file-exists? ruta-csv [
    print (word "[reglas_energia] No se encontro " ruta-csv)
    report serie
  ]
  let filas but-first csv:from-file ruta-csv
  foreach filas [ f ->
    let fecha-str (word item 0 f)
    if (length fecha-str >= length fecha-prefijo) and (substring fecha-str 0 (length fecha-prefijo) = fecha-prefijo) [
      set serie lput (item 3 f) serie
    ]
  ]
  report serie
end

; --- Reporters de metricas globales para monitores y graficos ---

to-report demanda-total-mw [ nodos ]
  report sum [ carga-actual-mw ] of nodos
end

to-report demanda-base-total-mw [ nodos ]
  report sum [ demanda-base-mw ] of nodos
end

to-report demanda-aa-total-mw [ nodos ]
  report sum [ demanda-aa-mw ] of nodos
end

to-report aa-encendidos-total [ nodos ]
  report sum [ aa-encendidos ] of nodos
end

to-report clientes-sin-luz [ nodos ]
  report sum [ clientes ] of (nodos with [ estado = "cortado" ])
end

to-report cortes-acumulados [ nodos ]
  report sum [ cant-cortes ] of nodos
end
